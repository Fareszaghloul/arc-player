[Desktop Entry]
Version=1.0
Name=Arc
Comment=Arc media client
Exec=arc-player
Icon=local.arc.Arc
Terminal=false
Type=Application
StartupWMClass=local.arc.Arc
Categories=AudioVideo;Video;Player;TV;

Actions=DesktopF;DesktopW;TVF;TVW

[Desktop Action DesktopF]
Name=Desktop [Fullscreen]
Exec=arc-player --fullscreen --desktop

[Desktop Action DesktopW]
Name=Desktop [Windowed]
Exec=arc-player --windowed --desktop

[Desktop Action TVF]
Name=TV [Fullscreen]
Exec=arc-player --fullscreen --tv

[Desktop Action TVW]
Name=TV [Windowed]
Exec=arc-player --windowed --tv
